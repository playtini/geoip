{
    "name": "playtini/geoip",
    "type": "library",
    "description": "Simple GeoIP Client for MaxMind and IP2Location Databases",
    "keywords": [
        "geoip",
        "maxmind",
        "ip2location",
        "geoip2",
        "client",
        "playtini",
        "country",
        "city",
        "proxy"
    ],
    "license": "GPL-3.0-only",
    "require": {
        "php": "^8.5",
        "geoip2/geoip2": "^3.5",
        "ip2location/ip2location-php": "^9.8",
        "twig/twig": "^3.31"
    },
    "require-dev": {
        "jangregor/phpstan-prophecy": "^2.3",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Playtini\\GeoIp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Playtini\\GeoIp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@php -d zend.assertions=1 vendor/bin/phpunit",
        "coverage": "@php -d zend.assertions=1 -d pcov.enabled=1 vendor/bin/phpunit --coverage-html var/coverage --coverage-text",
        "stan": "phpstan analyse",
        "check": [
            "@stan",
            "@test"
        ]
    }
}
